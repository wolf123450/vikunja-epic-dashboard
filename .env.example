# Copy to .env and fill in. Never commit a real .env.

# Required
VIKUNJA_API_URL=http://vikunja:3456
VIKUNJA_TOKEN=tk_replace_me

# Optional (defaults shown)
# VIKUNJA_PUBLIC_URL=https://vikunja.example.com
# PROJECT_IDS=12,15
# INCLUDE_CHILD_PROJECTS=true
# POINTS_PREFIX=sp:
# POINTS_SCALE=1,2,3,5,8,13,21,40
# EPIC_ALLOW_OVERLAP=true
# EPIC_PARENT_POINTS=false
# POINTS_SPLIT_THRESHOLD=5
# EPIC_MODE=both
# EPIC_PREFIX=epic:
# EPIC_MARKER_LABEL=epic
# SYNC_INTERVAL_SEC=300
# SNAPSHOT_TIME=03:00
# TZ=America/Los_Angeles
# PORT=8080
# DATA_DIR=/data
# KANBAN_VIEW_ID=12:34,15:40
# BUCKET_COLORS=Backlog:#9ca3af,In Review:#a855f7

# Docker Compose only (read by compose, not the app)
# DASHBOARD_PORT=8080
# With docker-compose.network.yml: name of Vikunja's Docker network
# VIKUNJA_NETWORK=vikunja_default
