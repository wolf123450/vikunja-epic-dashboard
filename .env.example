# POINTS_ALLOWED=1,2,3,5,8,13,20,40
# POINTS_SPLIT_THRESHOLD=5
# EPIC_MODE=both
# EPIC_PREFIX=epic:
# EPIC_MARKER_LABEL=epic
# SYNC_INTERVAL_SEC=300
# SNAPSHOT_TIME=03:00
# TZ=America/Los_Angeles
# PORT=8080
# DATA_DIR=/data
# KANBAN_VIEW_ID=12:34,15:40
